$TTL 86400
@   IN  SOA     ns1.servicelink.ahmed. root.servicelink.ahmed. (
                2026051601 ; Serial
                3600       ; Refresh
                1800       ; Retry
                604800     ; Expire
                86400 )    ; Minimum TTL

; سكريبت يحدد سيرفر الـ DNS الرئيسي للنطاق
@   IN  NS      ns1.servicelink.ahmed.

; توجيه اسم السيرفر ونطاق الموقع إلى الأي بي الخاص بالأباتشي
ns1 IN  A       10.1.100.5
@   IN  A       10.1.100.5
www IN  A       10.1.100.5
